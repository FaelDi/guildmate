# ---------------------------------------------------------------------------
# GuildMate — environment variables
# Copy to .env (or .env.local) for development. On Vercel, set these in
# Project Settings > Environment Variables (never commit real values).
#
# NOTE: nothing here is prefixed with NEXT_PUBLIC_, and that is deliberate.
# The browser never talks to Supabase; every call goes through this app's own
# server. See docs/SECURITY.md ("Supabase is never reachable from the client").
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Supabase Dashboard > Connect > ORMs / Connection string.
# Use the TRANSACTION POOLER (port 6543) at runtime: serverless invocations are
# short lived and the pooler is what survives that.
# Format: postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.projectref:password@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"

# Direct (session) connection, port 5432. drizzle-kit uses this for migrations,
# because DDL does not work over the transaction pooler.
DIRECT_URL="postgresql://postgres.projectref:password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase API (server-side only) ---------------------------------------
# Dashboard > Project Settings > API Keys.
SUPABASE_URL="https://projectref.supabase.co"

# New-style keys (sb_publishable_... / sb_secret_...). The legacy names
# SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are still accepted as a
# fallback, so an older project keeps working.
SUPABASE_PUBLISHABLE_KEY=""
# Bypasses row level security. NEVER send it to the browser, never prefix it
# with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# Optional. Defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
# Access tokens are verified locally against these keys, with no round trip.
SUPABASE_JWKS_URL=""

# Optional, and only for legacy projects that still sign JWTs symmetrically.
# Leave EMPTY when the project publishes asymmetric keys (ES256) via JWKS —
# setting it would force the wrong verification path.
SUPABASE_JWT_SECRET=""

# Bucket for item screenshots. Create it as PRIVATE: the app streams objects
# through /api/storage/* after checking the caller, so public access would
# defeat the proxy.
SUPABASE_STORAGE_BUCKET="guildmate-uploads"

# --- Scheduled jobs --------------------------------------------------------
# Shared secret for the Vercel Cron endpoint (/api/cron/sweep).
# Vercel sends `Authorization: Bearer $CRON_SECRET`. The route fails closed:
# an unset secret makes it return 404 rather than run.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Application secrets ---------------------------------------------------
# Pepper mixed into event join codes before hashing, so a database leak alone
# does not let an attacker brute-force short codes offline.
# Changing this invalidates every live event code.
# Generate with: openssl rand -hex 32
EVENT_CODE_PEPPER=""
